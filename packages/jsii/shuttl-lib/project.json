{
    "name": "@shuttl-io/core",
    "$schema": "../../../node_modules/nx/schemas/project-schema.json",
    "projectType": "library",
    "sourceRoot": "packages/jsii/shuttl-lib",
    "targets": {
        "release-js": {
            "executor": "nx:run-commands",
            "options": {
                "command": "bash ./publish.sh --js-only",
                "cwd": "{projectRoot}"
            },
            "dependsOn": [
                "package"
            ]
        },
        "release-python": {
            "executor": "nx:run-commands",
            "options": {
                "command": "bash ./publish.sh --python-only",
                "cwd": "{projectRoot}"
            },
            "dependsOn": [
                "package"
            ]
        },
        "release-java": {
            "executor": "nx:run-commands",
            "options": {
                "command": "bash ./publish.sh --java-only",
                "cwd": "{projectRoot}"
            },
            "dependsOn": [
                "package"
            ]
        },
        "release-dotnet": {
            "executor": "nx:run-commands",
            "options": {
                "command": "bash ./publish.sh --dotnet-only",
                "cwd": "{projectRoot}"
            },
            "dependsOn": [
                "package"
            ]
        },
        "release-go": {
            "executor": "nx:run-commands",
            "options": {
                "command": "bash ./publish.sh --go-only",
                "cwd": "{projectRoot}"
            },
            "dependsOn": [
                "package"
            ]
        },
        "nx-release-publish": {
            "executor": "nx:run-commands",
            "options": {
                "command": "echo 'All language releases completed'",
                "cwd": "{projectRoot}"
            },
            "dependsOn": [
                "release-js",
                "release-python",
                "release-java",
                "release-dotnet",
                "release-go"
            ]
        },
        "add": {
            "executor": "nx:run-commands",
            "options": {
                "command": "pnpm add",
                "cwd": "{projectRoot}"
            }
        },
        "test:integration": {
            "executor": "@nx/jest:jest",
            "outputs": [
                "{workspaceRoot}/coverage/{projectRoot}"
            ],
            "options": {
                "jestConfig": "packages/jsii/shuttl-lib/integration-tests/jest.config.js",
                "passWithNoTests": true,
                "runInBand": true
            },
            "dependsOn": [
                "build",
                "package"
            ]
        }
    }
}